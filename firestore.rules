rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Real Two-Player Matchmaking Queue (Supports Google Auth & Instant Guests)
    match /pond_queue/{userId} {
      allow read, write, delete: if true;
    }
    
    // Active Chat Rooms & Messages Subcollection
    match /chat_rooms/{roomId} {
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Direct UPI Payment Verification Requests
    match /payment_requests/{utr} {
      allow read, write: if true;
    }

    // User Profiles & Subscription Balances
    match /users/{userId} {
      allow read, write: if true;
    }

    // Generated UPI Orders
    match /pending_upi_orders/{orderId} {
      allow read, write: if true;
    }
  }
}
